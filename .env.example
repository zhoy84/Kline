# Vercel + Neon Database
POSTGRES_URL=postgresql://neondb_owner:password@host:port/database?channel_binding=require&sslmode=require
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=password
POST_DATABASE=neondb

# App configuration
DRAWDOWN_THRESHOLD_PCT=20
LOOKBACK_DAYS=5

# CoinGecko API (free, no rate limits for basic usage, no API key required)
# https://www.coingecko.com/en/api
# Get a free API key for higher rate limits: https://www.coingecko.com/api/api-key

# COIN_GECKO_API_KEY=  (optional)

# Note: CoinGecko provides free historical OHLC data without authentication.
# For production use with frequent syncs, consider getting an API key.
